pipeline {
    agent any

    stages {
        stage('Hostname') {
            steps {
                sh '''
                    echo 'this is to get hostname'
                    hostname
                '''
            }
        }
         stage('memory') {
            steps {
                sh '''
                    echo 'this is to get memory'
                    free -h
                '''
            }
        }
         stage('date') {
            steps {
                sh '''
                    echo 'this is to get current date'
                    date
                '''
            }
        }
         stage('running process ') {
            steps {
                sh '''
                    echo 'this is to get running process'
                    ps -aux | head -10
                '''
            }
        }
    }
}